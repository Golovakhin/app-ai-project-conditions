# AI-слой: провайдер LLM и его параметры
LLM_PROVIDER=ollama

# Локальная модель (Ollama)
OLLAMA_MODEL=qwen3:4b-instruct
OLLAMA_BASE_URL=http://localhost:11434

# Облачный провайдер с OpenAI-совместимым API
CLOUD_BASE_URL=https://openrouter.ai/api/v1
CLOUD_MODEL=
CLOUD_API_KEY=
CLOUD_PROJECT=

LLM_TEMPERATURE=0.1